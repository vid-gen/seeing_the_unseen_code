+            idy = (points[:, 1] <= upper_bound[1]) & (points[:, 1] >= lower_bound[1])
+            idz = (points[:, 2] <= upper_bound[2]) & (points[:, 2] >= lower_bound[2])
+            points = points[idx & idy & idz]
